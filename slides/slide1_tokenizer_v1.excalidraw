    {
      "type": "text",
      "id": "problem_text1",
      "x": 75, "y": 452,
      "width": 1030, "height": 26,
      "text": "Tokens are discretized — transformer must learn to reconstruct continuous spectrum from discrete tokens. No guarantee tokens align with physically meaningful boundaries.",
